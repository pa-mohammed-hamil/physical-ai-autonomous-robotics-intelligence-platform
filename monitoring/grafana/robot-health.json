
{
  "version": "1.0.0",
  "simulation_only": true,
  "robot_health": {
    "enabled": true,
    "monitoring_interval_seconds": 5,
    "health_score_range": [0, 100],
    "status_thresholds": {
      "healthy": 80,
      "warning": 60,
      "critical": 30
    }
  },
  "components": {
    "motor": {
      "enabled": true,
      "temperature_warning_c": 75,
      "temperature_critical_c": 95,
      "current_warning_a": 18,
      "current_critical_a": 30,
      "vibration_warning_mm_s": 6,
      "vibration_critical_mm_s": 12,
      "monitor_overload": true,
      "monitor_bearing_wear": true
    },
    "battery": {
      "enabled": true,
      "soc_warning_percent": 15,
      "soc_critical_percent": 5,
      "temperature_warning_c": 48,
      "temperature_critical_c": 65,
      "monitor_voltage": true,
      "monitor_state_of_health": true
    },
    "sensors": {
      "enabled": true,
      "warning_health_score": 0.65,
      "critical_health_score": 0.25,
      "monitor_dropout": true,
      "monitor_drift": true,
      "monitor_noise": true,
      "monitor_calibration": true
    },
    "joints": {
      "enabled": true,
      "position_error_warning_deg": 5,
      "position_error_critical_deg": 15,
      "monitor_velocity": true,
      "monitor_torque": true,
      "monitor_temperature": true,
      "monitor_wear": true
    },
    "actuators": {
      "enabled": true,
      "temperature_warning_c": 75,
      "temperature_critical_c": 95,
      "monitor_stall": true,
      "monitor_overload": true,
      "monitor_position_error": true
    },
    "communication": {
      "enabled": true,
      "latency_warning_ms": 500,
      "latency_critical_ms": 2000,
      "monitor_connection": true,
      "monitor_packet_loss": true
    }
  },
  "ai_health_prediction": {
    "enabled": true,
    "anomaly_detection": true,
    "failure_prediction": true,
    "remaining_useful_life_prediction": true,
    "failure_probability_warning": 0.6,
    "failure_probability_critical": 0.85,
    "rul_warning_hours": 200,
    "rul_critical_hours": 50
  },
  "maintenance": {
    "enabled": true,
    "predictive_maintenance": true,
    "maintenance_recommendations": true,
    "work_order_creation": true,
    "human_approval_required": true
  },
  "alerts": {
    "enabled": true,
    "severity_levels": [
      "info",
      "warning",
      "high",
      "critical"
    ],
    "notify_on_low_health": true,
    "notify_on_motor_failure": true,
    "notify_on_overheating": true,
    "notify_on_low_battery": true,
    "notify_on_sensor_failure": true,
    "notify_on_joint_failure": true,
    "notify_on_communication_loss": true
  },
  "safety": {
    "simulated_emergency_stop_enabled": true,
    "simulated_motion_inhibition_enabled": true,
    "human_review_required": true,
    "physical_robot_control_enabled": false,
    "hardware_actuation_enabled": false,
    "autonomous_physical_execution_enabled": false,
    "automatic_emergency_stop_reset_enabled": false
  },
  "dashboard": {
    "enabled": true,
    "refresh_interval_seconds": 5,
    "show_health_score": true,
    "show_component_health": true,
    "show_live_telemetry": true,
    "show_failure_predictions": true,
    "show_rul_prediction": true,
    "show_maintenance_recommendations": true,
    "show_safety_alerts": true
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "output": "reports/robot_health.json"
  }
}
