# providers: infrastructure placeholder. No cloud resources are provisioned.

# ============================================================
# Physical AI Robotics - Terraform Providers
# File: terraform/providers.tf
# ============================================================

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }

    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
      Application = "Physical-AI-Robotics"
    }
  }
}

provider "random" {}
