
# ============================================================
# PHYSICAL AI & AUTONOMOUS ROBOTICS INTELLIGENCE PLATFORM
# Environment Configuration Template
# ============================================================

# APPLICATION
APP_NAME="Physical AI & Autonomous Robotics Intelligence Platform"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# FASTAPI BACKEND
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AUTHENTICATION
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DATABASE
DATABASE_URL=postgresql+psycopg://robotics:change-me@localhost:5432/physical_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=physical_ai
POSTGRES_USER=robotics
POSTGRES_PASSWORD=change-me

# REDIS
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ROBOT SIMULATION
ROBOT_MODE=simulation
SIMULATION_ENABLED=true
SIMULATION_ONLY=true
SIMULATION_ENGINE=mujoco
SIMULATION_TIMESTEP=0.002
SIMULATION_SEED=42
MAX_ROBOTS=10

# PHYSICAL HARDWARE RESTRICTIONS
PHYSICAL_ROBOT_CONTROL_ENABLED=false
HARDWARE_ACTUATION_ENABLED=false
ROBOT_DRIVER_ENABLED=false
ACTUATOR_COMMANDS_ENABLED=false
REMOTE_MOTION_COMMANDS_ENABLED=false
AUTONOMOUS_PHYSICAL_EXECUTION_ENABLED=false
EMERGENCY_STOP_RESET_ENABLED=false
SAFETY_INTERLOCKS_REQUIRED=true

# ROBOT HEALTH
ROBOT_HEALTH_MONITORING_ENABLED=true
ROBOT_HEALTH_INTERVAL_SECONDS=5
ANOMALY_DETECTION_ENABLED=true
FAILURE_PREDICTION_ENABLED=true
RUL_PREDICTION_ENABLED=true
PREDICTIVE_MAINTENANCE_ENABLED=true

# COMPUTER VISION
COMPUTER_VISION_ENABLED=true
OBJECT_DETECTION_ENABLED=true
DEFECT_DETECTION_ENABLED=true
HUMAN_DETECTION_ENABLED=true
DEFAULT_CV_MODEL_PATH=ml/artifacts/object_detector.pt

# AI / MACHINE LEARNING
ML_ENABLED=true
ML_MODEL_DIR=ml/artifacts
ML_DEVICE=auto
ML_FALLBACK_DEVICE=cpu
ML_BATCH_SIZE=16
ML_INFERENCE_TIMEOUT_SECONDS=30
ML_SERVER_HOST=127.0.0.1
ML_SERVER_PORT=8001

# GENERATIVE AI
GENAI_ENABLED=true
LLM_PROVIDER=local
LLM_MODEL=configure-your-model
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ADVANCED RAG
RAG_ENABLED=true
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PATH=storage/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKING_ENABLED=true
HYBRID_SEARCH_ENABLED=true
RAG_TOP_K=5

# AGENTIC AI
AGENTS_ENABLED=true
MULTI_AGENT_ENABLED=true
AGENT_TOOL_CALLING_ENABLED=true
AGENT_MAX_ITERATIONS=10
HUMAN_APPROVAL_REQUIRED=true

# TELEMETRY
TELEMETRY_ENABLED=true
TELEMETRY_INTERVAL_MS=1000
TELEMETRY_STORAGE_PATH=data/telemetry
WEBSOCKET_ENABLED=true
WEBSOCKET_TELEMETRY_PATH=/ws/telemetry
WEBSOCKET_ALERTS_PATH=/ws/alerts

# OPTIONAL MESSAGE BROKERS
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MAINTENANCE & COST INTELLIGENCE
MAINTENANCE_ENABLED=true
WORK_ORDER_ENABLED=true
COST_ESTIMATION_ENABLED=true
CURRENCY=INR
PRICE_INTELLIGENCE_ENABLED=true
INVENTORY_MANAGEMENT_ENABLED=true

# DIGITAL TWIN / WORLD MODEL
DIGITAL_TWIN_ENABLED=true
WORLD_MODEL_ENABLED=true
VLA_ENABLED=true
RL_TRAINING_ENABLED=false

# MLOPS
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_PATH=ml/registry
MODEL_MONITORING_ENABLED=true
DATA_DRIFT_DETECTION_ENABLED=true
EXPERIMENT_TRACKING_ENABLED=true

# MONITORING
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3001
METRICS_ENABLED=true
METRICS_PATH=/metrics

# SAFETY
SAFETY_MONITORING_ENABLED=true
COLLISION_DETECTION_ENABLED=true
HUMAN_PROXIMITY_DETECTION_ENABLED=true
SIMULATED_EMERGENCY_STOP_ENABLED=true
SIMULATED_MOTION_INHIBITION_ENABLED=true
AUTOMATIC_EMERGENCY_STOP_RESET_ENABLED=false

# SECURITY
PROMPT_INJECTION_PROTECTION_ENABLED=true
PII_PROTECTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
FILE_UPLOAD_MAX_MB=25

# STORAGE
UPLOAD_DIR=storage/uploads
REPORT_DIR=reports
LOG_DIR=logs
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=25

# FRONTEND
FRONTEND_PORT=3000
FRONTEND_THEME=light
FRONTEND_ANIMATIONS_ENABLED=true
FRONTEND_DEMO_MODE=true

# EMAIL NOTIFICATIONS
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ALERTS
ALERTS_ENABLED=true
ALERT_COOLDOWN_SECONDS=30
ALERT_DEDUPLICATION_SECONDS=60
CRITICAL_ALERTS_ENABLED=true

# TESTING
TESTING=false
TEST_DATABASE_URL=sqlite:///storage/test_robotics.db
